@page "/show-ToDos"
@using System.Data.SqlTypes
@using System.Reflection.Metadata
@using System.Linq
@inject IJSRuntime JS
@using todos
@inject ToDoStorage Storage
<PageTitle>Show ToDo</PageTitle>
<div id="showMainWrapper">
    <h1>Dina ToDo's</h1>
    <section id="antalSection">
        <img src="/Images/list.jpg" alt="">
        <p>Antal ToDo's: @todos.Count(todo => todo.Done == false)</p>
    </section>
    <div id="tablesDiv">
        <table>
            <colgroup>
                <col class="task-column">
                <col class="done-column">
                <col class="delete-column">
                <col class="priority-column">
            </colgroup>
            <thead>
                <tr>
                    <th colspan="4" class="rubrik">Hem och fritid</th>
                </tr>
                <tr>
                    <th>Att göra:</th>
                    <th>Klar?</th>
                    <th>Radera</th>
                    <th>Prio</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var todo in todos)
    
    
                {
                    if (todo.Category == "Hem och fritid")
                    {
                        int index = todos.IndexOf(todo);

                        <tr>
                            <td>@todo.Task</td>
                            <td><input type="checkbox" @bind="todo.Done" @onclick="() => changeStatus(index)" class="checkbox"></td>
                            <td><i class="fa-solid fa-trash-can fa-xl" id="@index" @onclick="() => deleteTodo(index)"></i></td>
                            <td>@todo.Priority</td>
                        </tr>
                        //binder värdet av checkboxen till todo.Done - ibockad är true , urbockad blir false
                    }
       
                }
            </tbody>

        </table>

        <table>
            <colgroup>
                <col class="task-column">
                <col class="done-column">
                <col class="delete-column">
                <col class="priority-column">
            </colgroup>
            <thead>
                <tr>
                    <th colspan="4" class="rubrik">Skola</th>
                </tr>
                <tr>
                    <th>Att göra:</th>
                    <th>Klar?</th>
                    <th>Radera</th>
                    <th>Prio</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var todo in todos)
    
                {
                    if (todo.Category == "Skola")
                    {
                        int index = todos.IndexOf(todo);
                
                        <tr>
                            <td>@todo.Task</td>
                            <td><input type="checkbox" @bind="todo.Done" @onclick="() => changeStatus(index)" class="checkbox"></td>
                            <td><i class="fa-solid fa-trash-can fa-xl" id="@index" @onclick="() => deleteTodo(index)"></i></td>
                            <td>@todo.Priority</td>
                        </tr>
                    }
       
                }
            </tbody>
        </table>

        <table>
            <colgroup>
                <col class="task-column">
                <col class="done-column">
                <col class="delete-column">
                <col class="priority-column">
            </colgroup>
    
            <thead>
                <tr>
                    <th colspan="4" class="rubrik">Jobb</th>
                </tr>
                <tr>
                    <th>Att göra:</th>
                    <th>Klar?</th>
                    <th>Radera</th>
                    <th>Prio</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var todo in todos)
    
                {
                    if (todo.Category == "Jobb")
                    {
                        <!--skriv ut todo med olika fält. ikonen trashcan har onclick-event som kallar 
            på metod deleteTodo och skickar med index som argument-->
                        int index = todos.IndexOf(todo);
                
                        <tr>
                            <td>@todo.Task</td>
                            <td><input type="checkbox" @bind="todo.Done" @onclick="() => changeStatus(index)" class="checkbox"></td>
                            <td><i class="fa-solid fa-trash-can fa-xl" id="@index" @onclick="() => deleteTodo(index)"></i></td>
                            <td>@todo.Priority</td>
                        </tr>
                    }
       
                }
            </tbody>
        </table>
    </div>
</div>
@code {
    // List<ToDo> todos = new List<ToDo>();
   
    List<ToDo> todos = new List<ToDo>();
  



    protected override async Task OnInitializedAsync()
    {
        List<ToDo> allToDos = await Storage.Load();
        @foreach (ToDo todo in allToDos)
        {
            todos.Add(new ToDo { Task = todo.Task, Priority = todo.Priority, Done = todo.Done, Category = todo.Category });
        }

    }


    private void changeStatus(int index)
    {
        //ändrar bool Done för todo med specifikt index till true eller false (det den inte var innan)
        todos[index].Done = !todos[index].Done;
        Storage.Save(todos); //spara todos för att spara ändringen
    }



    private void deleteTodo(int index)
    {
        //tar bort todo med index som skickats med från listan
        todos.RemoveAt(index);
        Storage.Save(todos); //sparar listan
        
        
    }
}