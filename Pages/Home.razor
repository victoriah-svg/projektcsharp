@page "/"

<PageTitle>Home</PageTitle>

    <div id="heroDiv">
        <img src="/Images/hero-bild.jpg" alt="">
    </div>
<div id=homeMainWrapper>
    <h1 id="welcomeTxt">Välkommen till Task Done!</h1>
    <p>En applikation för att strukturera ditt liv i form av ToDo-Listor</p>

    <div id="homeBoxNavDiv">
        <h2>Vad vill du göra?</h2>
        <section class="startNavSection" id="navSecAdd">
            <i class="fa-solid fa-circle-plus fa-5x"></i>
            <a href="/add"><h3>Lägg till ToDo</h3></a>
        </section>
        <section class="startNavSection" id="navSecShow">
            <img src="/Images/list.jpg" alt="checklist" id="checklistImg">
            <a href="/show-ToDos"><h3>Se och hantera din ToDo-lista</h3></a>
        </section>
    </div>
</div>

