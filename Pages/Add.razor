@page "/add"
@using System.Data.SqlTypes
@using todos
@inject ToDoStorage Storage /*injicerar klassen för att kunna anropa metoder Load och Save*/
<PageTitle>Add ToDo</PageTitle>
<div id=addMainWrapper>
    <h1>Lägg till ny ToDo</h1>

    <form>
        <label for="task">Beskriv uppgift:</label>
        <input @bind="newTask" @onclick="changeValidationMsg" type="text" id="task" name="task">
        <div class="errorMsg">@errorMsg</div>
    
        <label for="priority">Prioritet 1-3 (1 = högst, 3 = lägst):</label>
        <select id="priority" name="priority" @bind="newPriority">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
        </select>

        <label for="category">Välj kategori:</label>
        <select id="category" name="category" @bind="newCategory">
            <option value="Hem och fritid">Hem och fritid</option>
            <option value="Jobb">Jobb</option>
            <option value="Skola">Skola</option>
        </select>
         <div class="validationMsg">@validationMsg</div>

        <button @onclick="AddTodo" type="button">Spara ToDo <i class="fa-solid fa-plus fa-lg"></i></button>
    </form>
</div>

@code {

    List<ToDo> todos = new List<ToDo>();

    string newTask = "";

    string errorMsg = "";
    int newPriority = 1;

    string validationMsg = "";

    bool done = false; //sätter till false för vill att done ska vara false när en todo läggs till

    string newCategory = "Hem och fritid";

    // ToDo myToDo = new ToDo (task: "handla", priority: 1, done: true, category: "hem och fritid");
    //Lägg till metod AddToDo som triggas när knappen klickas - men först kontrollerar att värden ej är tomma
    //just nu skriv bara ut värdena på skärmen - senare anropa save med listan av todos

    protected override async Task OnInitializedAsync()
    {
        List<ToDo> todosToSave = await Storage.Load();
        foreach (ToDo todo in todosToSave)
        {
            todos.Add(new ToDo { Task = todo.Task, Priority = todo.Priority, Done = todo.Done, Category = todo.Category });
        }

    }

    private async Task AddTodo(MouseEventArgs args)
    {

        if (string.IsNullOrWhiteSpace(newTask))
        {
            errorMsg = "Du måste fylla i uppgift";
            validationMsg = "";
        }
        else if (newTask.Length > 30)
        {
            errorMsg = "Uppgiftsbeskrivning får inte vara längre än 30 karaktärer";
            validationMsg = "";
        }
        else
        {
            todos.Add(new ToDo { Task = newTask, Priority = newPriority, Done = done, Category = newCategory });
            Storage.Save(todos); //anropar Save från ToDoStorage som anropar async js-funktion för att spara i localStorage
            newTask = ""; //rensar fältet newTask
            newPriority = 1; //sätter tillbaka värdet på priority att vara 1 som default
            newCategory = "Hem och fritid"; //sätter tillbaka defaultvärde på kategori
            errorMsg = "";
            validationMsg ="ToDo tillagd!"; //lägger till validation message

        }


    }

//Metod som rensar innehåll i validation message 
    private void changeValidationMsg()
    {
         validationMsg = "";
    }
}